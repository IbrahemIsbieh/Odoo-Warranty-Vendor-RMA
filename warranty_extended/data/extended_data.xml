<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_extended_warranty" model="product.template">
        <field name="name">Extended Warranty</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>

    <record id="plan_1_year" model="warranty.extension.plan">
        <field name="name">1 Year Extension</field>
        <field name="months">12</field>
        <field name="percent">10.0</field>
    </record>
    <record id="plan_2_years" model="warranty.extension.plan">
        <field name="name">2 Years Extension</field>
        <field name="months">24</field>
        <field name="percent">18.0</field>
    </record>
    <record id="plan_3_years" model="warranty.extension.plan">
        <field name="name">3 Years Extension</field>
        <field name="months">36</field>
        <field name="percent">25.0</field>
    </record>
</odoo>