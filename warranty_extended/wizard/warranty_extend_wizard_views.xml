<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_extend_wizard_form" model="ir.ui.view">
        <field name="name">warranty.extend.wizard.form</field>
        <field name="model">warranty.extend.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="warranty_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="plan_id" options="{'no_create': True}"/>
                        <field name="base_amount"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="current_end_date"/>
                        <field name="new_end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Add Extension"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>