<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_warranty_expiring" model="mail.template">
        <field name="name">Warranty: expiring soon</field>
        <field name="model_id" ref="model_warranty_record"/>
        <field name="subject">Your warranty {{ object.name }} expires in 30 days</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p>Dear <t t-out="object.partner_id.name"/>,</p>
                <p>
                    The warranty for <strong><t t-out="object.product_id.display_name"/></strong>
                    (<t t-out="object.name"/>) will expire on
                    <strong><t t-out="object.end_date"/></strong>.
                </p>
                <p>If you face any issue with the product, please submit a claim before this date.</p>
            </div>
        </field>
    </record>
</odoo>