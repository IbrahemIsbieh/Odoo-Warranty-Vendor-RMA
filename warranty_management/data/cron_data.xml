<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_warranty_update_states" model="ir.cron">
        <field name="name">Warranty: expire old warranties</field>
        <field name="model_id" ref="model_warranty_record"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_warranty_notify_expiring" model="ir.cron">
        <field name="name">Warranty: notify expiring in 30 days</field>
        <field name="model_id" ref="model_warranty_record"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring(30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>