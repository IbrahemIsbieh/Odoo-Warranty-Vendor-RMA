<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claim_resolve_wizard_form" model="ir.ui.view">
        <field name="name">warranty.claim.resolve.wizard.form</field>
        <field name="model">warranty.claim.resolve.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="claim_id" invisible="1"/>
                    <field name="resolution" widget="radio"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>