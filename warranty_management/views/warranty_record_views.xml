<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_record_list" model="ir.ui.view">
        <field name="name">warranty.record.list</field>
        <field name="model">warranty.record</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_left"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_warranty_record_form" model="ir.ui.view">
        <field name="name">warranty.record.form</field>
        <field name="model">warranty.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="sale_line_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="duration_months"/>
                            <field name="extra_months"/>
                            <field name="end_date"/>
                            <field name="days_left"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_warranty_record_search" model="ir.ui.view">
        <field name="name">warranty.record.search</field>
        <field name="model">warranty.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <separator/>
                <filter name="expiring" string="Expiring in 30 days"
                        domain="[('state','=','active'),
                                 ('end_date','&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_record" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">warranty.record</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>