<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_warranty" model="ir.ui.view">
        <field name="name">product.template.form.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="warranty_months"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_warranties" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="warranty_count == 0">
                    <field name="warranty_count" widget="statinfo" string="Warranties"/>
                </button>
            </div>
        </field>
    </record>
</odoo>