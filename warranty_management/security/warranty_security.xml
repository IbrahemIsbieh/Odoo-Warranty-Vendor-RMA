<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_warranty" model="ir.module.category">
        <field name="name">Warranty</field>
        <field name="sequence">30</field>
    </record>

    <!-- Odoo 19: الـ privilege هو الوسيط بين التصنيف والمجموعات -->
    <record id="res_groups_privilege_warranty" model="res.groups.privilege">
        <field name="name">Warranty</field>
        <field name="category_id" ref="module_category_warranty"/>
    </record>

    <record id="group_warranty_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_warranty"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_warranty_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_warranty"/>
        <field name="implied_ids" eval="[(4, ref('group_warranty_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Portal: customers see only their own records -->
    <record id="rule_warranty_record_portal" model="ir.rule">
        <field name="name">Warranty: portal own records</field>
        <field name="model_id" ref="model_warranty_record"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_warranty_claim_portal" model="ir.rule">
        <field name="name">Warranty claim: portal own records</field>
        <field name="model_id" ref="model_warranty_claim"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Internal users: multi-company -->
    <record id="rule_warranty_record_company" model="ir.rule">
        <field name="name">Warranty: multi-company</field>
        <field name="model_id" ref="model_warranty_record"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>